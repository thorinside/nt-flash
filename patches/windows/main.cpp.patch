 //------------------------------------------------------------------------------
 // Bootloader Operations (Flashloader)
 //------------------------------------------------------------------------------
+
+// Query PnP's list of *present* interfaces, not WinMM or a new HID handle.
+// Enumeration errors (including a changing list) aren't evidence of removal.
+static win_handoff::Presence flashloaderPresence(const std::string& path) {
+    GUID hidClass;
+    HidD_GetHidGuid(&hidClass);
+    ULONG size = 0;
+    if (CM_Get_Device_Interface_List_SizeA(&size, &hidClass, nullptr,
+            CM_GET_DEVICE_INTERFACE_LIST_PRESENT) != CR_SUCCESS || !size)
+        return win_handoff::Presence::unknown;
+    std::vector<char> paths(size);
+    if (CM_Get_Device_Interface_ListA(&hidClass, nullptr, paths.data(), size,
+            CM_GET_DEVICE_INTERFACE_LIST_PRESENT) != CR_SUCCESS)
+        return win_handoff::Presence::unknown;
+    for (const char* p = paths.data(); *p; p += strlen(p) + 1)
+        if (_stricmp(p, path.c_str()) == 0) return win_handoff::Presence::present;
+    return win_handoff::Presence::absent;
+}
 
+class FlashloaderTransport : public UsbHidPacketizer {
+public:
+    using UsbHidPacketizer::UsbHidPacketizer;
+    void useResetTimeout() { m_packetTimeoutMs = 500; }
+};
+
