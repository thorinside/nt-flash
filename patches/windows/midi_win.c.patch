+// WinMM permits unprepare after submission; STILLPLAYING means it still owns
+// both the MIDIHDR and lpData. No callback or unsynchronised flag reads needed.
+static MMRESULT waitForRelease(HMIDIOUT out, MIDIHDR* header) {
+    ULONGLONG start = GetTickCount64();
+    for (;;) {
+        MMRESULT rc = midiOutUnprepareHeader(out, header, sizeof *header);
+        if (rc != MIDIERR_STILLPLAYING || GetTickCount64() - start >= 2000) return rc;
+        Sleep(10);
+    }
+}
