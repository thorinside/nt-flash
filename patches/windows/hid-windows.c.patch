         {
-            /* WriteFile() failed. Return error. */
-            CancelIo(dev->device_handle);
+            /* WriteFile() failed without queuing this write. */
             register_error(dev, L"WriteFile");
             bytes_written = -1;
             goto end_of_function;
@@ -672,9 +680,10 @@
