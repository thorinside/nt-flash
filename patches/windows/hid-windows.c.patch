--- a/hid-windows.c
+++ b/hid-windows.c
@@ -619,6 +619,15 @@
 err:
     free_hid_device(dev);
     return NULL;
+}
+
+/* Cancellation is asynchronous. Do not reuse or release an OVERLAPPED, its
+ * event, or its buffer until the kernel has completed that particular I/O. */
+static void cancel_and_drain(HANDLE file, OVERLAPPED *io)
+{
+    DWORD ignored;
+    CancelIoEx(file, io); /* ERROR_NOT_FOUND is normal if completion won the race. */
+    GetOverlappedResult(file, io, &ignored, TRUE);
 }
 
