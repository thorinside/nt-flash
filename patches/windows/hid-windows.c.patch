+/* Cancellation is asynchronous. Do not reuse or release an OVERLAPPED, its
+ * event, or its buffer until the kernel has completed that particular I/O. */
+static BOOL cancel_and_drain(HANDLE file, OVERLAPPED *io, DWORD *bytes, BOOL *pending)
+{
+    CancelIoEx(file, io); /* ERROR_NOT_FOUND is normal when completion wins. */
+    WaitForSingleObject(io->hEvent, 1000);
+    BOOL ok = GetOverlappedResult(file, io, bytes, FALSE);
+    *pending = !ok && !HasOverlappedIoCompleted(io);
+    return ok;
+}
